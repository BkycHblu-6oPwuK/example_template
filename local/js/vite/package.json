    "ssr-server": "node server"
  },
  "dependencies": {
    "@vueuse/core": "*",
    "swiper": "*",
    "axios": "*",
    "dotenv": "*",
    "vue": "*",
    "vuex": "*",
    "compression": "*",
    "express": "*",
    "sirv": "*"
  },
  "devDependencies": {
    "@vitejs/plugin-vue": "*",
    "sass": "*",
    "unplugin-vue-macros": "*",
    "vite": "*",
    "vite-plugin-style-import": "*",
    "cross-env": "*"
  }
}
